# ==============================
# Application
# ==============================
APP_NAME=AI Interview Coach
APP_ENV=development
DEBUG=True

# ==============================
# PostgreSQL
# ==============================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=interview_coach
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/interview_coach

# ==============================
# OpenAI
# ==============================
OPENAI_API_KEY=

# ==============================
# VAPI - Optional
# ==============================
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# ==============================
# ChromaDB
# ==============================
CHROMA_HOST=localhost
CHROMA_PORT=8000